# Kopieren nach .env und Werte anpassen (lokal) bzw. als Umgebungsvariablen
# in Railway unter Project -> Variables eintragen.

# Pfad fuer die SQLite-Datei; auf Railway auf ein Volume zeigen lassen, z.B. /data
DB_DIR=

# Login-Zugangsdaten fuer den allerersten Start (danach in der App aenderbar)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Zufaelliger, fester Wert zum Signieren der Login-Session (z.B. mit
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` erzeugen)
SESSION_SECRET=

# Aktiviert u.a. sichere Cookies (nur ueber HTTPS gueltig) - auf Railway setzen
NODE_ENV=production

# ---------- Marketing (Social Media & Grafik) ----------
# KI-Gestaltung der Posts und Druckgrafiken
ANTHROPIC_API_KEY=
# Dropbox (gleiche App wie fuers Backup moeglich; braucht Lese-Rechte files.metadata.read + files.content.read)
# DROPBOX_ROOT = optionaler Startordner fuer die Medienauswahl, z.B. /Kreatief
DROPBOX_ROOT=
# Instagram/Facebook ueber die Meta Graph API (dauerhafter Seiten-Token)
META_PAGE_ID=
META_PAGE_TOKEN=
META_IG_USER_ID=
# Oeffentliche Adresse des Tools (Instagram holt die freigegebenen Bilder dort ab)
PUBLIC_BASE_URL=https://office.martinrenner.de
